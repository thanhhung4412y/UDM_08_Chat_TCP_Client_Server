 s=E1=BA=BB n=E1=BB=99i b=E1=BB=99 =C4=91=E1=BB=83 c=C3=A1c th=C3=A0nh vi=
=C3=AAn c=C3=B3 th=E1=BB=83 ph=E1=BB=91i h=E1=BB=A3p ph=C3=A1t tri=E1=BB=83=
n, t=C3=ADch h=E1=BB=A3p v=C3=A0 ki=E1=BB=83m th=E1=BB=AD =E1=BB=A9ng d=E1=
=BB=A5ng.</p>
