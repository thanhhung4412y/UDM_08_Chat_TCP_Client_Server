<p local-id=3D"7e6a3f9328f3"><strong>2.2.2. Ki=E1=BB=83m th=E1=BB=AD t=C3=
=ADch h=E1=BB=A3p (Integration Testing)</strong></p>
<p local-id=3D"ea0e0eaa5088">Ki=E1=BB=83m th=E1=BB=AD t=C3=ADch h=E1=BB=A3p=
 t=E1=BA=ADp trung =C4=91=C3=A1nh gi=C3=A1 kh=E1=BA=A3 n=C4=83ng ph=E1=BB=
=91i h=E1=BB=A3p gi=E1=BB=AFa c=C3=A1c th=C3=A0nh ph=E1=BA=A7n sau khi =C4=
=91=C6=B0=E1=BB=A3c k=E1=BA=BFt n=E1=BB=91i, =C4=91=E1=BA=B7c bi=E1=BB=87t =
l=C3=A0 qu=C3=A1 tr=C3=ACnh trao =C4=91=E1=BB=95i d=E1=BB=AF li=E1=BB=87u g=
i=E1=BB=AFa Client, Server v=C3=A0 c=C6=A1 s=E1=BB=9F d=E1=BB=AF li=E1=BB=
=87u.</p>
<p local-id=3D"96ef3fea7437">C=C3=A1c n=E1=BB=99i dung ki=E1=BB=83m th=E1=
=BB=AD bao g=E1=BB=93m:</p>
<ul local-id=3D"47168c06-0b77-49fc-916a-0db29244588c">
<li local-id=3D"c3e61707-c415-4713-8386-a8567d8d5e4b">
<p local-id=3D"add9611cba85">K=E1=BA=BFt n=E1=BB=91i Client=E2=80=93Server:=
 Ki=E1=BB=83m tra qu=C3=A1 tr=C3=ACnh thi=E1=BA=BFt l=E1=BA=ADp k=E1=BA=BFt=
 n=E1=BB=91i TCP/TLS, x=C3=A1c minh ch=E1=BB=A9ng ch=E1=BB=89 Server v=C3=
=A0 x=E1=BB=AD l=C3=BD c=C3=A1c t=C3=ACnh hu=E1=BB=91ng m=E1=BA=A5t k=E1=BA=
=BFt n=E1=BB=91i, k=E1=BA=BFt n=E1=BB=91i l=E1=BA=A1i.</p>
