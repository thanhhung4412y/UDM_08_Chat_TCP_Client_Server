<p local-id=3D"1bff041f09df">&nbsp;</p>
<p local-id=3D"4213022e1ef1"><strong>4.2. Chi ti=E1=BA=BFt c=C3=A1c h=C3=AC=
nh th=E1=BB=A9c tr=C3=B2 chuy=E1=BB=87n v=C3=A0 quy tr=C3=ACnh nghi=E1=BB=
=87p v=E1=BB=A5</strong></p>
<p local-id=3D"d708cfb23e6d"><strong>4.2.1. Tr=C3=B2 chuy=E1=BB=87n ph=C3=
=B2ng chung (public chat)</strong></p>
<ul local-id=3D"f3dbee85ed3a">
<li local-id=3D"1e44948e612f">
<p local-id=3D"0366f3fbbc9b">M=E1=BB=A5c =C4=91=C3=ADch nghi=E1=BB=87p v=E1=
=BB=A5: T=E1=BA=A1o kh=C3=B4ng gian th=E1=BA=A3o lu=E1=BA=ADn m=E1=BB=9F ch=
o t=E1=BA=A5t c=E1=BA=A3 ng=C6=B0=E1=BB=9Di d=C3=B9ng =C4=91ang k=E1=BA=BFt=
 n=E1=BB=91i v=C3=A0o h=E1=BB=87 th=E1=BB=91ng.</p>
</li>
<li local-id=3D"31cb370428c7">
<p local-id=3D"de242f36e036">Quy tr=C3=ACnh v=E1=BA=ADn h=C3=A0nh:</p>
</li>
</ul>
<ol start=3D"1" local-id=3D"ad699a910a4c">
<li local-id=3D"9abf90705e4b">
<p local-id=3D"a2da3c805f4a">Tr=C3=AAn giao di=E1=BB=87n ng=C6=B0=E1=BB=9Di=
 d=C3=B9ng (UI), =C3=B4 ch=E1=BB=8Dn =C4=91=E1=BB=91i t=C6=B0=E1=BB=A3ng nh=
=E1=BA=ADn receiverBox m=E1=BA=B7c =C4=91=E1=BB=8Bnh l=C3=A0 "Ph=C3=B2ng ch=
ung".</p>
</li>
</ol>
<ol start=3D"2" local-id=3D"f23822f95215">
<li local-id=3D"cbb412fbe5c7">
<p local-id=3D"ff2c87580f5b">Ng=C6=B0=E1=BB=9Di d=C3=B9ng nh=E1=BA=ADp n=E1=
=BB=99i dung v=C4=83n b=E1=BA=A3n v=C3=A0o messageInput v=C3=A0 b=E1=BA=A5m=
 n=C3=BAt G=E1=BB=ADi ho=E1=BA=B7c nh=E1=BA=A5n ph=C3=ADm Enter.</p>
</li>
</ol>
<ol start=3D"3" local-id=3D"c805bea750e2">
<li local-id=3D"6e1d73bf365f">
<p local-id=3D"e6e71efc73a1">Client =C4=91=C3=B3ng g=C3=B3i d=E1=BB=AF li=
=E1=BB=87u JSON mang lo=E1=BA=A1i "type": "chat" v=C3=A0 truy=E1=BB=81n qua=
 k=C3=AAnh TCP/TLS.</p>
</li>
</ol>
<ol start=3D"4" local-id=3D"62564a570426">
<li local-id=3D"328e4f4ec706">
<p local-id=3D"c313f165a4c3">Server ki=E1=BB=83m tra x=C3=A1c th=E1=BB=B1c =
ng=C6=B0=E1=BB=9Di g=E1=BB=ADi, b=E1=BB=95 sung m=E1=BB=91c th=E1=BB=9Di gi=
an/=C4=91=E1=BB=8Bnh danh duy nh=E1=BA=A5t v=C3=A0 Broadcast g=C3=B3i tin t=
=E1=BB=9Bi to=C3=A0n b=E1=BB=99 danh s=C3=A1ch k=E1=BA=BFt n=E1=BB=91i =C4=
=91ang active.</p>
</li>
</ol>
<ul local-id=3D"cc8a7d5d0e15">
<li local-id=3D"a95b87b7550c">
<p local-id=3D"41f4c72a5947">=C4=90=E1=BB=8Bnh d=E1=BA=A1ng hi=E1=BB=83n th=
=E1=BB=8B:</p>
</li>
</ul>
<p local-id=3D"5522888afe5c">Prefix m=E1=BB=91c th=E1=BB=9Di gian v=C3=A0 k=
=C3=AAnh: [dd/MM/yyyy HH:mm:ss] [Ph=C3=B2ng chung] T=C3=AAnNg=C6=B0=E1=BB=
=9DiG=E1=BB=ADi: N=E1=BB=99i dung.</p>
<p local-id=3D"ef682041f792"><strong>4.2.2. Tr=C3=B2 chuy=E1=BB=87n ri=C3=
=AAng t=C6=B0 1-1 (private chat)</strong></p>
<ul local-id=3D"832eb5d0499e">
<li local-id=3D"9414542d1d72">
<p local-id=3D"87dea625a018">M=E1=BB=A5c =C4=91=C3=ADch nghi=E1=BB=87p v=E1=
=BB=A5: =C4=90=E1=BA=A3m b=E1=BA=A3o t=C3=ADnh ri=C3=AAng t=C6=B0 cho c=C3=
=A1c cu=E1=BB=99c h=E1=BB=99i tho=E1=BA=A1i 1-1 gi=E1=BB=AFa 2 c=C3=A1 nh=
=C3=A2n.</p>
</li>
<li local-id=3D"71aed8ebe0b6">
<p local-id=3D"7f1b0371a3fc">Quy tr=C3=ACnh v=E1=BA=ADn h=C3=A0nh:</p>
</li>
</ul>
<ol start=3D"1" local-id=3D"339c4de620e9">
<li local-id=3D"c54b6bceabdd">
<p local-id=3D"57fd8a698b5f">Ng=C6=B0=E1=BB=9Di d=C3=B9ng ch=E1=BB=8Dn t=C3=
=A0i kho=E1=BA=A3n b=E1=BA=A1n chat t=E1=BB=AB danh s=C3=A1ch x=E1=BB=95 xu=
=E1=BB=91ng receiverBox (Server t=E1=BB=B1 =C4=91=E1=BB=99ng c=E1=BA=ADp nh=
=E1=BA=ADt danh s=C3=A1ch khi c=C3=B3 s=E1=BB=B1 ki=E1=BB=87n ng=C6=B0=E1=
=BB=9Di d=C3=B9ng v=C3=A0o/ra).</p>
</li>
</ol>
<ol start=3D"2" local-id=3D"a13ad42fc77e">
<li local-id=3D"201b0465c95e">
<p local-id=3D"5e65876bc535">G=C3=B3i tin g=E1=BB=ADi =C4=91i ch=E1=BB=A9a =
tr=C6=B0=E1=BB=9Dng =C4=91=E1=BB=8Bnh danh =C4=91=E1=BB=91i t=C6=B0=E1=BB=
=A3ng nh=E1=BA=ADn "to": "&lt;T=C3=AAn_ng=C6=B0=E1=BB=9Di_nh=E1=BA=ADn&gt;"=
 v=C3=A0 "type": "private".</p>
</li>
</ol>
<ol start=3D"3" local-id=3D"3514a5ddf0b3">
<li local-id=3D"ecfbef8f407a">
<p local-id=3D"2ff95390e93e">Server tra c=E1=BB=A9u b=E1=BA=A3ng =C3=A1nh x=
=E1=BA=A1 Socket Table theo username ng=C6=B0=E1=BB=9Di nh=E1=BA=ADn:</p>
</li>
</ol>
<ol start=3D"4" local-id=3D"2bd29333aa4c">
<li local-id=3D"19bf164b9930">
<p local-id=3D"e0b7c980bce9">Tr=C6=B0=E1=BB=9Dng h=E1=BB=A3p Online: Server=
 chuy=E1=BB=83n ti=E1=BA=BFp g=C3=B3i tin t=E1=BB=9Bi socket ng=C6=B0=E1=BB=
=9Di nh=E1=BA=ADn, =C4=91=E1=BB=93ng th=E1=BB=9Di ph=E1=BA=A3n h=E1=BB=93i =
m=E1=BB=99t b=E1=BA=A3n sao (mirroring) v=E1=BB=81 socket ng=C6=B0=E1=BB=9D=
i g=E1=BB=ADi =C4=91=E1=BB=83 hi=E1=BB=83n th=E1=BB=8B =C4=91=E1=BB=93ng b=
=E1=BB=99.</p>
</li>
</ol>
<ol start=3D"5" local-id=3D"be74b25443db">
<li local-id=3D"c7d0b794d995">
<p local-id=3D"9d6fe37285ae">Tr=C6=B0=E1=BB=9Dng h=E1=BB=A3p Offline / =C4=
=90=C3=A3 ng=E1=BA=AFt k=E1=BA=BFt n=E1=BB=91i: Server ph=E1=BA=A3n h=E1=BB=
=93i g=C3=B3i tin b=C3=A1o l=E1=BB=97i: {"type": "error", "text": "Nguoi nh=
an khong online"}.</p>
</li>
</ol>
<ul local-id=3D"792e23ada274">
<li local-id=3D"c378b451fd4f">
<p local-id=3D"345f50da14aa">=C4=90=E1=BB=8Bnh d=E1=BA=A1ng hi=E1=BB=83n th=
=E1=BB=8B:</p>
</li>
</ul>
<p local-id=3D"ff80c76c93c0">Ph=C3=ADa ng=C6=B0=E1=BB=9Di g=E1=BB=ADi: [Th=
=E1=BB=9Di gian] [Ri=C3=AAng B=E1=BA=A1n (Alice) =E2=86=92 Bob]: N=E1=BB=99=
i dung.</p>
<p local-id=3D"585b9389d454">Ph=C3=ADa ng=C6=B0=E1=BB=9Di nh=E1=BA=ADn: [Th=
=E1=BB=9Di gian] [Ri=C3=AAng Alice =E2=86=92 Bob]: N=E1=BB=99i dung.</p>
<p local-id=3D"59f8eb437e8f"><strong>4.2.3. Tr=E1=BA=A3 l=E1=BB=9Di tin nh=
=E1=BA=AFn tr=C3=ADch d=E1=BA=ABn (reply)</strong></p>
<ul local-id=3D"546927e10c0e">
<li local-id=3D"22e6ee660d06">
<p local-id=3D"9052de390d65">M=E1=BB=A5c =C4=91=C3=ADch nghi=E1=BB=87p v=E1=
=BB=A5: T=E1=BA=A1o m=E1=BB=91i li=C3=AAn k=E1=BA=BFt ng=E1=BB=AF c=E1=BA=
=A3nh r=C3=B5 r=C3=A0ng gi=E1=BB=AFa c=C3=A2u tr=E1=BA=A3 l=E1=BB=9Di m=E1=
=BB=9Bi v=C3=A0 n=E1=BB=99i dung =C4=91=C3=A3 g=E1=BB=ADi tr=C6=B0=E1=BB=9B=
c =C4=91=C3=B3 trong ph=C3=B2ng chat.</p>
</li>
<li local-id=3D"b8a333c8ac87">
<p local-id=3D"e2a84954896a">Quy tr=C3=ACnh v=E1=BA=ADn h=C3=A0nh:</p>
</li>
</ul>
<ol start=3D"1" local-id=3D"46d2ffdafc16">
<li local-id=3D"00d863ad4bb1">
<p local-id=3D"d589b01ef0b0">Ng=C6=B0=E1=BB=9Di d=C3=B9ng b=C3=B4i =C4=91en=
 =C4=91o=E1=BA=A1n v=C4=83n b=E1=BA=A3n c=E1=BA=A7n tr=E1=BA=A3 l=E1=BB=9Di=
 tr=C3=AAn khung hi=E1=BB=83n th=E1=BB=8B chatBox, ch=E1=BB=8Dn t=C3=A1c v=
=E1=BB=A5 Reply (qua n=C3=BAt b=E1=BA=A5m ho=E1=BA=B7c menu chu=E1=BB=99t p=
h=E1=BA=A3i).</p>
</li>
</ol>
<ol start=3D"2" local-id=3D"1b3b56552749">
<li local-id=3D"a6c9a52bf273">
<p local-id=3D"ba6e9d71d085">Client t=E1=BB=B1 =C4=91=E1=BB=99ng tr=C3=ADch=
 xu=E1=BA=A5t chu=E1=BB=97i v=C4=83n b=E1=BA=A3n (t=E1=BB=91i =C4=91a 500 k=
=C3=BD t=E1=BB=B1), =C4=91=E1=BB=95i placeholder =C3=B4 nh=E1=BA=ADp th=C3=
=A0nh "=C4=90ang Reply: &lt;=C4=91o=E1=BA=A1n tr=C3=ADch d=E1=BA=ABn&gt;...=
".</p>
</li>
</ol>
<ol start=3D"3" local-id=3D"87ee2e6df800">
<li local-id=3D"cf84adf3969d">
<p local-id=3D"11b1b9eca7f7">Khi g=E1=BB=ADi, g=C3=B3i tin mang c=C3=A1c tr=
=C6=B0=E1=BB=9Dng "type": "reply", "quote": "&lt;=C4=91o=E1=BA=A1n tr=C3=AD=
ch d=E1=BA=ABn&gt;", "text": "&lt;c=C3=A2u tr=E1=BA=A3 l=E1=BB=9Di&gt;".</p=
>
</li>
</ol>
<ul local-id=3D"5f297bd876b0">
<li local-id=3D"82e3f432c904">
<p local-id=3D"97c49e87e645">=C4=90=E1=BB=8Bnh d=E1=BA=A1ng hi=E1=BB=83n th=
=E1=BB=8B:</p>
</li>
</ul>
<p local-id=3D"a3a469829685">[Th=E1=BB=9Di gian] [Ph=C3=B2ng chung] Alice:<=
/p>
<p local-id=3D"30bb7e1e7273">-&gt; Reply: =C4=90o=E1=BA=A1n tr=C3=ADch d=E1=
=BA=ABn tr=C6=B0=E1=BB=9Bc =C4=91=C3=B3</p>
<p local-id=3D"1a522df9be94">&nbsp;N=E1=BB=99i dung tr=E1=BA=A3 l=E1=BB=9Di=
 c=E1=BB=A7a Alice</p>
<p local-id=3D"28c69fd33743"><strong>4.2.4. Chuy=E1=BB=83n ti=E1=BA=BFp tin=
 nh=E1=BA=AFn (forward)</strong></p>
<ul local-id=3D"4c40b3e93cf8">
<li local-id=3D"6187f33c7599">
<p local-id=3D"dd021a5f55cc">M=E1=BB=A5c =C4=91=C3=ADch nghi=E1=BB=87p v=E1=
=BB=A5: Cho ph=C3=A9p chia s=E1=BA=BB l=E1=BA=A1i n=E1=BB=99i dung tin nh=
=E1=BA=AFn c=C3=B3 s=E1=BA=B5n m=C3=A0 kh=C3=B4ng c=E1=BA=A7n g=C3=B5 l=E1=
=BA=A1i ho=E1=BA=B7c sao ch=C3=A9p th=E1=BB=A7 c=C3=B4ng.</p>
</li>
<li local-id=3D"67504d8f8d6a">
<p local-id=3D"78afc773d8f8">Quy tr=C3=ACnh v=E1=BA=ADn h=C3=A0nh:</p>
</li>
</ul>
<ol start=3D"1" local-id=3D"39db29a90112">
<li local-id=3D"e35d92b429e5">
<p local-id=3D"d3ffeaf65a7e">Ng=C6=B0=E1=BB=9Di d=C3=B9ng ch=E1=BB=8Dn =C4=
=91o=E1=BA=A1n tin nh=E1=BA=AFn tr=C3=AAn chatBox v=C3=A0 k=C3=ADch ho=E1=
=BA=A1t l=E1=BB=87nh Forward.</p>
</li>
</ol>
<ol start=3D"2" local-id=3D"4c9c1adf8854">
<li local-id=3D"31ebcd4d471d">
<p local-id=3D"9607c5477b7c">Ch=E1=BB=8Dn =C4=91=E1=BB=91i t=C6=B0=E1=BB=A3=
ng nh=E1=BA=ADn th=C3=B4ng qua receiverBox (chuy=E1=BB=83n ti=E1=BA=BFp v=
=C3=A0o Ph=C3=B2ng chung ho=E1=BA=B7c g=E1=BB=ADi ri=C3=AAng cho m=E1=BB=99=
t c=C3=A1 nh=C3=A2n).</p>
</li>
</ol>
<ol start=3D"3" local-id=3D"9301b13300b6">
<li local-id=3D"8dd6f9e95131">
<p local-id=3D"7b1792861703">Client t=E1=BA=A1o g=C3=B3i tin "type": "forwa=
rd" g=E1=BB=ADi l=C3=AAn Server x=E1=BB=AD l=C3=BD =C4=91=E1=BB=8Bnh tuy=E1=
=BA=BFn.</p>
</li>
</ol>
<ul local-id=3D"392099bb4dce">
<li local-id=3D"21287695ce00">
<p local-id=3D"9aa40fc40c6e">=C4=90=E1=BB=8Bnh d=E1=BA=A1ng hi=E1=BB=83n th=
=E1=BB=8B:</p>
</li>
</ul>
<p local-id=3D"77697120ea60">&nbsp;[Th=E1=BB=9Di gian] [Tuy=E1=BA=BFn tin] =
T=C3=AAnNg=C6=B0=E1=BB=9DiG=E1=BB=ADi: [Forward] N=E1=BB=99i dung =C4=91=C6=
=B0=E1=BB=A3c chuy=E1=BB=83n ti=E1=BA=BFp.</p>
<p local-id=3D"28522ea709a0"><strong>4.3. Chu=E1=BA=A9n giao th=E1=BB=A9c d=
=E1=BB=AF li=E1=BB=87u (json protocol specification)</strong></p>
<p local-id=3D"d903a34a6837">T=E1=BA=A5t c=E1=BA=A3 d=E1=BB=AF li=E1=BB=87u=
