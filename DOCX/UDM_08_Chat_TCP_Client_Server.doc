c n=C4=83ng</h1>
<h2 local-id=3D"253cb01c4e6e" id=3D"UDM_08_Chat_TCP_Client_Server-1.T=E1=BB=
=95ngquan.1">1.T=E1=BB=95ng quan</h2>
<ul local-id=3D"383a55a18c2a">
<li local-id=3D"242d756e2f1a">
<p local-id=3D"9c6febc7745d">UDM_08_ChatApp l=C3=A0 =E1=BB=A9ng d=E1=BB=A5n=
g tr=C3=B2 chuy=E1=BB=87n theo m=C3=B4 h=C3=ACnh TCP Client=E2=80=93Server,=
 =C4=91=C6=B0=E1=BB=A3c x=C3=A2y d=E1=BB=B1ng nh=E1=BA=B1m h=E1=BB=97 tr=E1=
=BB=A3 nhi=E1=BB=81u ng=C6=B0=E1=BB=9Di d=C3=B9ng trao =C4=91=E1=BB=95i th=
=C3=B4ng tin th=C3=B4ng qua giao di=E1=BB=87n =C4=91=E1=BB=93 h=E1=BB=8Da (=
GUI). Giao di=E1=BB=87n ch=C3=ADnh (Main GUI) =C4=91=C6=B0=E1=BB=A3c ph=C3=
=A1t tri=E1=BB=83n b=E1=BA=B1ng ng=C3=B4n ng=E1=BB=AF C++ v=C3=A0 framework=
 Qt. Vai tr=C3=B2 d=E1=BB=B1 ki=E1=BA=BFn c=E1=BB=A7a giao di=E1=BB=87n ch=
=C3=ADnh l=C3=A0 cung c=E1=BA=A5p c=E1=BB=ADa s=E1=BB=95 =C4=91=E1=BB=83 ng=
=C6=B0=E1=BB=9Di d=C3=B9ng nh=E1=BA=ADp th=C3=B4ng tin k=E1=BA=BFt n=E1=BB=
=91i, xem danh s=C3=A1ch li=C3=AAn h=E1=BB=87, ch=E1=BB=8Dn cu=E1=BB=99c tr=
=C3=B2 chuy=E1=BB=87n, so=E1=BA=A1n v=C3=A0 xem tin nh=E1=BA=AFn.</p>
</li>
</ul>
<p local-id=3D"c7e042548e37"></p>
<ul local-id=3D"f340d8a97a86">
<li local-id=3D"1eb0d3e6c37d">
<p local-id=3D"c11d9a003575">T=C3=ACnh tr=E1=BA=A1ng tri=E1=BB=83n khai: c=
=C3=A1c file MainWindow =C4=91=C3=A3 g=E1=BB=ADi hi=E1=BB=87n m=E1=BB=9Bi c=
ung c=E1=BA=A5p c=E1=BB=ADa s=E1=BB=95 Qt kh=E1=BB=9Fi t=E1=BA=A1o ban =C4=
=91=E1=BA=A7u. File .ui =C4=91=E1=BB=8Bnh ngh=C4=A9a m=E1=BB=99t c=E1=BB=AD=
a s=E1=BB=95 QMainWindow k=C3=ADch th=C6=B0=E1=BB=9Bc 800 =C3=97 600, c=C3=
=B3 central widget =C4=91ang tr=E1=BB=91ng, menu bar v=C3=A0 status bar. C=
=C3=A1c file C++ =C4=91=C6=B0=E1=BB=A3c g=E1=BB=ADi th=E1=BB=B1c hi=E1=BB=
=87n kh=E1=BB=9Fi t=E1=BA=A1o giao di=E1=BB=87n v=C3=A0 gi=E1=BA=A3i ph=C3=
=B3ng =C4=91=E1=BB=91i t=C6=B0=E1=BB=A3ng giao di=E1=BB=87n khi c=E1=BB=ADa=
 s=E1=BB=95 b=E1=BB=8B h=E1=BB=A7y. Trong c=C3=A1c file n=C3=A0y ch=C6=B0a =
c=C3=B3 khu v=E1=BB=B1c k=E1=BA=BFt n=E1=BB=91i, danh s=C3=A1ch li=C3=AAn h=
=E1=BB=87, =C3=B4 t=C3=ACm ki=E1=BA=BFm, khu v=E1=BB=B1c chat, =C3=B4 nh=E1=
=BA=ADp tin nh=E1=BA=AFn ho=E1=BA=B7c ch=E1=BB=A9c n=C4=83ng g=E1=BB=ADi ti=
n nh=E1=BA=AFn.</p>
</li>
</ul>
<h2 local-id=3D"73279b2dd06f" id=3D"UDM_08_Chat_TCP_Client_Server-2.Y=C3=AA=
uc=E1=BA=A7u">2.Y=C3=AAu c=E1=BA=A7u</h2>
<p local-id=3D"3e759c5fc86f"><strong>2.1 T=C3=A1c nh=C3=A2n</strong></p>
<p local-id=3D"39eb11a8f092">Client (=E1=BB=A8ng d=E1=BB=A5ng kh=C3=A1ch):<=
/p>
<p local-id=3D"e8146c6c3133">+ =C4=90=E1=BB=8Bnh ngh=C4=A9a: L=C3=A0 ng=C6=
=B0=E1=BB=9Di s=E1=BB=AD d=E1=BB=A5ng tr=E1=BB=B1c ti=E1=BA=BFp ph=E1=BA=A7=
n m=E1=BB=81m TCP Client c=C3=A0i =C4=91=E1=BA=B7t tr=C3=AAn thi=E1=BA=BFt =
b=E1=BB=8B c=C3=A1 nh=C3=A2n =C4=91=E1=BB=83 k=E1=BA=BFt n=E1=BB=91i t=E1=
=BB=9Bi m=C3=A1y ch=E1=BB=A7.</p>
<p local-id=3D"10722b4f65b4">+Vai tr=C3=B2 &amp; Tr=C3=A1ch nhi=E1=BB=87m: =
Ch=E1=BB=A7 =C4=91=E1=BB=99ng kh=E1=BB=9Fi t=E1=BA=A1o k=E1=BA=BFt n=E1=BB=
=91i m=E1=BA=A1ng, th=E1=BB=B1c hi=E1=BB=87n =C4=91=C4=83ng nh=E1=BA=ADp, g=
=E1=BB=ADi/nh=E1=BA=ADn c=C3=A1c l=E1=BB=87nh =C4=91i=E1=BB=81u khi=E1=BB=
=83n =C4=91=E1=BB=8Bnh d=E1=BA=A1ng JSON, v=C3=A0 th=E1=BB=B1c hi=E1=BB=87n=
 c=C3=A1c lu=E1=BB=93ng truy=E1=BB=81n t=E1=BA=A3i d=E1=BB=AF li=E1=BB=87u =
l=E1=BB=9Bn (Upload/Download Video).</p>
<p local-id=3D"43596e5e0413">Admin (Ng=C6=B0=E1=BB=9Di qu=E1=BA=A3n tr=E1=
=BB=8B h=E1=BB=87 th=E1=BB=91ng):
<br>
+=C4=90=E1=BB=8Bnh ngh=C4=A9a: L=C3=A0 ng=C6=B0=E1=BB=9Di v=E1=BA=ADn h=C3=
=A0nh v=C3=A0 qu=E1=BA=A3n l=C3=BD ph=E1=BA=A7n m=E1=BB=81m TCP Server.</p>
<p local-id=3D"ec5a8c2a7c56">+Vai tr=C3=B2 &amp; Tr=C3=A1ch nhi=E1=BB=87m: =
C=E1=BA=A5u h=C3=ACnh c=C3=A1c th=C3=B4ng s=E1=BB=91 m=E1=BA=A1ng (nh=C6=B0=
 thi=E1=BA=BFt l=E1=BA=ADp Port l=E1=BA=AFng nghe), kh=E1=BB=9Fi =C4=91=E1=
=BB=99ng m=C3=A1y ch=E1=BB=A7 v=C3=A0 gi=C3=A1m s=C3=A1t tr=E1=BB=B1c ti=E1=
=BA=BFp tr=E1=BA=A1ng th=C3=A1i c=C3=A1c k=E1=BA=BFt n=E1=BB=91i, nh=E1=BA=
=ADt k=C3=BD ho=E1=BA=A1t =C4=91=E1=BB=99ng (log) c=C5=A9ng nh=C6=B0 t=C3=
=ADnh to=C3=A0n v=E1=BA=B9n c=E1=BB=A7a d=E1=BB=AF li=E1=BB=87u lu=C3=A2n c=
huy=E1=BB=83n trong h=E1=BB=87 th=E1=BB=91ng.</p>
