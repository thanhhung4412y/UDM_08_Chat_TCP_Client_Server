<p local-id=3D"56b3c70f745a">C=C3=A1c ch=E1=BB=A9c n=C4=83ng =C4=91=C6=B0=
=E1=BB=A3c chia th=C3=A0nh hai nh=C3=B3m ch=C3=ADnh t=C6=B0=C6=A1ng =E1=BB=
=A9ng v=E1=BB=9Bi vai tr=C3=B2 c=E1=BB=A7a Server v=C3=A0 Client:</p>
<p local-id=3D"71e1618be243"><strong>5.1 T=C3=ADnh n=C4=83ng c=E1=BB=A7a Se=
rver</strong></p>
<ul local-id=3D"d6aa271a67b0">
<li local-id=3D"ba92a09e6b18">
<p local-id=3D"558679befc4e">Kh=E1=BB=9Fi t=E1=BA=A1o m=C3=A1y ch=E1=BB=A7 =
TCP t=E1=BA=A1i =C4=91=E1=BB=8Ba ch=E1=BB=89 v=C3=A0 c=E1=BB=95ng =C4=91=C6=
=B0=E1=BB=A3c c=E1=BA=A5u h=C3=ACnh; chuy=E1=BB=83n sang tr=E1=BA=A1ng th=
=C3=A1i s=E1=BA=B5n s=C3=A0ng nh=E1=BA=ADn k=E1=BA=BFt n=E1=BB=91i.</p>
</li>
<li local-id=3D"a038d0b96652">
<p local-id=3D"523c74119a0e">Ti=E1=BA=BFp nh=E1=BA=ADn v=C3=A0 qu=E1=BA=A3n=
 l=C3=BD c=C3=A1c k=E1=BA=BFt n=E1=BB=91i t=E1=BB=AB Client; theo d=C3=B5i =
