<li local-id=3D"051b7a31-6a37-4dec-a6e7-17e94eeaa452">
<p local-id=3D"39da83d83479">Nh=E1=BA=ADp v=C3=A0 g=E1=BB=ADi tin nh=E1=BA=
=AFn th=C3=B4ng qua TCP Client.</p>
</li>
</ul>
</li>
<li local-id=3D"1a48d6df341b">
<p local-id=3D"e54bcc559146">Main GUI ch=E1=BB=8Bu tr=C3=A1ch nhi=E1=BB=87m=
 ti=E1=BA=BFp nh=E1=BA=ADn thao t=C3=A1c c=E1=BB=A7a ng=C6=B0=E1=BB=9Di d=
=C3=B9ng v=C3=A0 hi=E1=BB=83n th=E1=BB=8B th=C3=B4ng tin. Vi=E1=BB=87c x=E1=
=BB=AD l=C3=BD k=E1=BA=BFt n=E1=BB=91i TCP v=C3=A0 truy=E1=BB=81n d=E1=BB=
=AF li=E1=BB=87u =C4=91=C6=B0=E1=BB=A3c th=E1=BB=B1c hi=E1=BB=87n b=E1=BB=
=9Fi module TCP Client.</p>
</li>
</ul>
<p local-id=3D"eeb8fe3bc233">3.1.1 Flow c=E1=BB=A7a Server</p>
<p local-id=3D"5ec72fce5442">Lu=E1=BB=93ng ho=E1=BA=A1t =C4=91=E1=BB=99ng c=
=E1=BB=A7a giao di=E1=BB=87n ch=C3=ADnh m=C3=B4 t=E1=BA=A3 qu=C3=A1 tr=C3=
=ACnh ng=C6=B0=E1=BB=9Di d=C3=B9ng t=C6=B0=C6=A1ng t=C3=A1c v=E1=BB=9Bi =E1=
=BB=A9ng d=E1=BB=A5ng t=E1=BB=AB khi m=E1=BB=9F ch=C6=B0=C6=A1ng tr=C3=ACnh=
 =C4=91=E1=BA=BFn khi th=E1=BB=B1c hi=E1=BB=87n tr=C3=B2 chuy=E1=BB=87n.</p=
>
<p local-id=3D"f21fa3ec8c55"><strong>Main Flow:</strong></p>
<ol start=3D"1" local-id=3D"b7c1cf30-dfd2-4869-898a-4126b3bb4a23">
<li local-id=3D"3ee5ed45-f694-4a12-a728-6551167f1619">
<p local-id=3D"3298ca39c73f">Ng=C6=B0=E1=BB=9Di d=C3=B9ng kh=E1=BB=9Fi ch=
=E1=BA=A1y =E1=BB=A9ng d=E1=BB=A5ng ChatApp.</p>
</li>
<li local-id=3D"24b50e74-5d9f-4eeb-8e95-8aa2d5542aac">
<p local-id=3D"840d7587b5a9">H=E1=BB=87 th=E1=BB=91ng hi=E1=BB=83n th=E1=BB=
=8B c=E1=BB=ADa s=E1=BB=95 giao di=E1=BB=87n ch=C3=ADnh (Main GUI).</p>
</li>
<li local-id=3D"9a08cdeb-716e-456e-a810-cc68b13981e0">
<p local-id=3D"8ce05057b0cc">Ng=C6=B0=E1=BB=9Di d=C3=B9ng nh=E1=BA=ADp =C4=
=91=E1=BB=8Ba ch=E1=BB=89 IP v=C3=A0 Port c=E1=BB=A7a Server.</p>
</li>
<li local-id=3D"f6e2dca3-2b0b-4ae7-a3bf-c9b8984a5527">
<p local-id=3D"ae236b701da1">Ng=C6=B0=E1=BB=9Di d=C3=B9ng nh=E1=BA=A5n n=C3=
=BAt Connect =C4=91=E1=BB=83 y=C3=AAu c=E1=BA=A7u k=E1=BA=BFt n=E1=BB=91i.<=
/p>
</li>
<li local-id=3D"302d2712-00da-4047-8d22-f5d89a53a35c">
<p local-id=3D"599bbfafd8f8">TCP Client th=E1=BB=B1c hi=E1=BB=87n qu=C3=A1 =
tr=C3=ACnh k=E1=BA=BFt n=E1=BB=91i v=E1=BB=9Bi Server.</p>
</li>
<li local-id=3D"9ef5d53a-d4b5-4a93-89e2-5fc6dc70e99d">
<p local-id=3D"9eba4176cf73">N=E1=BA=BFu k=E1=BA=BFt n=E1=BB=91i th=C3=A0nh=
 c=C3=B4ng, giao di=E1=BB=87n c=E1=BA=ADp nh=E1=BA=ADt tr=E1=BA=A1ng th=C3=
=A1i k=E1=BA=BFt n=E1=BB=91i.</p>
</li>
<li local-id=3D"cf85cdb5-ee15-4a52-a21b-13e0284bdf92">
<p local-id=3D"3ef17b703e5d">Ng=C6=B0=E1=BB=9Di d=C3=B9ng xem danh s=C3=A1c=
h li=C3=AAn h=E1=BB=87 v=C3=A0 t=C3=ACm ki=E1=BA=BFm ng=C6=B0=E1=BB=9Di c=
=E1=BA=A7n tr=C3=B2 chuy=E1=BB=87n.</p>
</li>
<li local-id=3D"7e21f42a-7dc9-4623-b722-1159f1c5e438">
<p local-id=3D"1f9db934365d">Ng=C6=B0=E1=BB=9Di d=C3=B9ng l=E1=BB=B1a ch=E1=
=BB=8Dn m=E1=BB=99t li=C3=AAn h=E1=BB=87.</p>
