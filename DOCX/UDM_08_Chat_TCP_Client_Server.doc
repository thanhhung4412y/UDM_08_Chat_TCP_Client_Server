<li local-id=3D"a2fcf148-6526-46c1-8a09-ca95474235c3">
<p local-id=3D"6e539e26f448">Trao =C4=91=E1=BB=95i tin nh=E1=BA=AFn: Ki=E1=
=BB=83m tra kh=E1=BA=A3 n=C4=83ng g=E1=BB=ADi, nh=E1=BA=ADn v=C3=A0 chuy=E1=
=BB=83n ti=E1=BA=BFp tin nh=E1=BA=AFn gi=E1=BB=AFa c=C3=A1c Client th=C3=B4=
ng qua Server, bao g=E1=BB=93m nh=E1=BA=AFn tin c=C3=B4ng khai v=C3=A0 ri=
=C3=AAng t=C6=B0.</p>
</li>
<li local-id=3D"be65961a-bcec-4ede-946e-505d6e1e21a4">
<p local-id=3D"bd79e1db5adf">T=C6=B0=C6=A1ng t=C3=A1c gi=E1=BB=AFa c=C3=A1c=
 ch=E1=BB=A9c n=C4=83ng nh=E1=BA=AFn tin: Ki=E1=BB=83m tra s=E1=BB=B1 ph=E1=
=BB=91i h=E1=BB=A3p c=E1=BB=A7a c=C3=A1c ch=E1=BB=A9c n=C4=83ng tr=E1=BA=A3=
 l=E1=BB=9Di, chuy=E1=BB=83n ti=E1=BA=BFp tin nh=E1=BA=AFn, g=E1=BB=ADi emo=
ji v=C3=A0 sticker.</p>
</li>
<li local-id=3D"226e4a0d-00ab-4ed6-8628-6714c63fbb91">
<p local-id=3D"b28e7ae302b4">T=C3=ADch h=E1=BB=A3p truy=E1=BB=81n d=E1=BB=
=AF li=E1=BB=87u =C4=91a ph=C6=B0=C6=A1ng ti=E1=BB=87n: Ki=E1=BB=83m tra qu=
=C3=A1 tr=C3=ACnh ph=E1=BB=91i h=E1=BB=A3p gi=E1=BB=AFa Client g=E1=BB=ADi,=
 Server v=C3=A0 Client nh=E1=BA=ADn khi truy=E1=BB=81n h=C3=ACnh =E1=BA=A3n=
h, video.</p>
</li>
<li local-id=3D"a06fdefa-c4e1-44d9-a45f-862d85fbbbc6">
<p local-id=3D"1c2b8db190b7">T=C3=ADch h=E1=BB=A3p c=C6=A1 s=E1=BB=9F d=E1=
=BB=AF li=E1=BB=87u: Ki=E1=BB=83m tra kh=E1=BA=A3 n=C4=83ng l=C6=B0u tr=E1=
=BB=AF v=C3=A0 truy xu=E1=BA=A5t l=E1=BB=8Bch s=E1=BB=AD tr=C3=B2 chuy=E1=
=BB=87n sau khi c=C3=A1c Client th=E1=BB=B1c hi=E1=BB=87n trao =C4=91=E1=BB=
=95i tin nh=E1=BA=AFn.</p>
