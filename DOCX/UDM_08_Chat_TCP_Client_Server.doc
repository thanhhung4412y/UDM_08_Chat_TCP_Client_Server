<p local-id=3D"fb01f66ae055"><strong>2.1 Qu=E1=BA=A3n l=C3=AD ch=E1=BA=A5t =
l=C6=B0=E1=BB=A3ng</strong></p>
<p local-id=3D"16e74a6a9e3a">Th=E1=BB=B1c hi=E1=BB=87n vi=E1=BB=87c ki=E1=
=BB=83m tra m=E1=BB=99t nh=C3=B3m ch=E1=BB=A9c n=C4=83ng c=C3=B3 th=E1=BB=
=83 ch=E1=BA=A1y th=E1=BB=AD v=C3=A0 t=E1=BA=ADp trung ho=C3=A0n thi=E1=BB=
=87n n=C3=B3: (1) k=E1=BA=BFt n=E1=BB=91i TCP v=C3=A0 join; (2) danh s=C3=
=A1ch ng=C6=B0=E1=BB=9Di d=C3=B9ng v=C3=A0 chat c=C6=A1 b=E1=BA=A3n; (3) ch=
at ri=C3=AAng c=C3=B9ng reply/forward; (4) sticker v=C3=A0 chia s=E1=BA=BB =
=E1=BA=A3nh; (5) t=C3=ADch h=E1=BB=A3p, s=E1=BB=ADa l=E1=BB=97i v=C3=A0 ho=
=C3=A0n thi=E1=BB=87n t=C3=A0i li=E1=BB=87u.</p>
<p local-id=3D"14b3d0b7ce11"><strong>2.2 Ki=E1=BB=83m th=E1=BB=AD</strong><=
/p>
<ul local-id=3D"dd74b1c3e785">
<li local-id=3D"7ce8f0fd5eff">
<p local-id=3D"dba2801a5e8d">Th=E1=BB=B1c hi=E1=BB=87n r=C3=A0 so=C3=A1t ch=
=C3=A9o =C4=91=E1=BB=91i v=E1=BB=9Bi c=C3=A1c thay =C4=91=E1=BB=95i =E1=BA=
=A3nh h=C6=B0=E1=BB=9Fng t=E1=BB=9Bi giao th=E1=BB=A9c, x=E1=BB=AD l=C3=BD =
socket, =C4=91=E1=BB=8Bnh tuy=E1=BA=BFn tin nh=E1=BA=AFn v=C3=A0 c=E1=BA=AD=
p nh=E1=BA=ADt danh s=C3=A1ch online.</p>
</li>
<li local-id=3D"e52bc00f15e8">
<p local-id=3D"17dce4fa31c1">M=E1=BB=97i l=E1=BB=97i c=E1=BA=A7n c=C3=B3 m=
=C3=B4 t=E1=BA=A3, b=C6=B0=E1=BB=9Bc t=C3=A1i hi=E1=BB=87n, k=E1=BA=BFt qu=
=E1=BA=A3 mong =C4=91=E1=BB=A3i, k=E1=BA=BFt qu=E1=BA=A3 th=E1=BB=B1c t=E1=
=BA=BF, m=E1=BB=A9c =C4=91=E1=BB=99 =E1=BA=A3nh h=C6=B0=E1=BB=9Fng v=C3=A0 =
ng=C6=B0=E1=BB=9Di ph=E1=BB=A5 tr=C3=A1ch.</p>
</li>
<li local-id=3D"dcb252e45c3b">
<p local-id=3D"eb190fbac67d">C=C3=A1c thay =C4=91=E1=BB=95i quan tr=E1=BB=
=8Dng c=E1=BA=A7n =C4=91=C6=B0=E1=BB=A3c ki=E1=BB=83m tra build v=C3=A0 ch=
=E1=BA=A1y th=E1=BB=AD tr=C6=B0=E1=BB=9Bc khi h=E1=BB=A3p nh=E1=BA=A5t v=C3=
=A0o nh=C3=A1nh ch=C3=ADnh tr=C3=AAn GitHub.</p>
</li>
</ul>
<p local-id=3D"b6a23370a4d3"><strong>Quy tr=C3=ACnh:</strong></p>
<ul local-id=3D"9a90ea2cbd0b">
<li local-id=3D"da0ec87e3bc7">
<p local-id=3D"3804937a038b">Ki=E1=BB=83m tra x=E1=BB=AD l=C3=BD chu=E1=BB=
=97i UTF-8, tr=C6=B0=E1=BB=9Dng d=E1=BB=AF li=E1=BB=87u b=E1=BB=8B thi=E1=
=BA=BFu, JSON kh=C3=B4ng h=E1=BB=A3p l=E1=BB=87 v=C3=A0 th=C3=B4ng =C4=91i=
=E1=BB=87p r=E1=BB=97ng.</p>
</li>
<li local-id=3D"85f6f2bcd590">
<p local-id=3D"0f7bb3c00499">Ki=E1=BB=83m tra lu=E1=BB=93ng Client g=E1=BB=
=ADi th=C3=B4ng =C4=91i=E1=BB=87p l=C3=AAn Server v=C3=A0 Server ph=E1=BA=
=A3n h=E1=BB=93i/chuy=E1=BB=83n ti=E1=BA=BFp v=E1=BB=81 Client ph=C3=B9 h=
=E1=BB=A3p.</p>
</li>
<li local-id=3D"b0a041a20baf">
<p local-id=3D"1407a965522d">Ki=E1=BB=83m tra hai ho=E1=BA=B7c nhi=E1=BB=81=
u Client c=C3=B9ng k=E1=BA=BFt n=E1=BB=91i, tham gia, g=E1=BB=ADi tin nh=E1=
=BA=AFn v=C3=A0 c=E1=BA=ADp nh=E1=BA=ADt danh s=C3=A1ch online.</p>
</li>
<li local-id=3D"05ffdbd95a5c">
<p local-id=3D"443e4a4091fe">Ki=E1=BB=83m tra ri=C3=AAng vi=E1=BB=87c t=E1=
=BA=A1o v=C3=A0 ph=C3=A2n t=C3=ADch t=E1=BB=ABng lo=E1=BA=A1i th=C3=B4ng =
=C4=91i=E1=BB=87p: join, chat, private, reply, forward, sticker, image, joi=
ned, users, system v=C3=A0 error.</p>
</li>
<li local-id=3D"27964271b9d3">
<p local-id=3D"b34a3a00bd4f">Ki=E1=BB=83m tra c=C3=A1c t=C3=ACnh hu=E1=BB=
=91ng b=E1=BA=A5t th=C6=B0=E1=BB=9Dng: Server ch=C6=B0a ch=E1=BA=A1y, Clien=
t ng=E1=BA=AFt m=E1=BA=A1ng, ng=C6=B0=E1=BB=9Di nh=E1=BA=ADn kh=C3=B4ng tr=
=E1=BB=B1c tuy=E1=BA=BFn v=C3=A0 d=E1=BB=AF li=E1=BB=87u JSON sai.</p>
</li>
<li local-id=3D"bfc9c3b7bc7d">
<p local-id=3D"4efeb1b1c0b1">=C4=90=E1=BB=91i chi=E1=BA=BFu k=E1=BA=BFt qu=
=E1=BA=A3 v=E1=BB=9Bi c=C3=A1c y=C3=AAu c=E1=BA=A7u ch=E1=BB=A9c n=C4=83ng;=
 ghi nh=E1=BA=ADn r=C3=B5 ch=E1=BB=A9c n=C4=83ng =C4=91=E1=BA=A1t, ch=C6=B0=
a =C4=91=E1=BA=A1t v=C3=A0 b=C3=A1o c=C3=A1o l=E1=BA=A1i cho nh=C3=B3m.</p>
</li>
</ul>
<p local-id=3D"4f9a421de4e9"><strong>2.3 K=E1=BA=BF ho=E1=BA=A1ch =C4=91=C3=
=A0o t=E1=BA=A1o</strong></p>
<p local-id=3D"4f66da2c9276">Do =C4=91=C3=A2y l=C3=A0 d=E1=BB=B1 =C3=A1n h=
=E1=BB=8Dc ph=E1=BA=A7n, k=E1=BA=BF ho=E1=BA=A1ch =C4=91=C3=A0o t=E1=BA=A1o=
