 ho=E1=BA=B7c Discord cung c=E1=BA=A5p kh=E1=BA=A3 n=C4=83ng tr=C3=B2 chuy=
=E1=BB=87n v=E1=BB=9Bi nhi=E1=BB=81u t=C3=ADnh n=C4=83ng m=E1=BB=9F r=E1=BB=
=99ng nh=C6=B0 =C4=91=E1=BB=93ng b=E1=BB=99 =C4=91=C3=A1m m=C3=A2y, g=E1=BB=
=8Di tho=E1=BA=A1i v=C3=A0 chia s=E1=BA=BB =C4=91a ph=C6=B0=C6=A1ng ti=E1=
=BB=87n. Tuy nhi=C3=AAn, c=C3=A1c n=E1=BB=81n t=E1=BA=A3ng n=C3=A0y ph=E1=
=BB=A5 thu=E1=BB=99c v=C3=A0o d=E1=BB=8Bch v=E1=BB=A5 v=C3=A0 h=E1=BA=A1 t=
=E1=BA=A7ng c=E1=BB=A7a nh=C3=A0 cung c=E1=BA=A5p, =C4=91=E1=BB=93ng th=E1=
=BB=9Di c=C3=B3 ph=E1=BA=A1m vi ch=E1=BB=A9c n=C4=83ng l=E1=BB=9Bn h=C6=A1n=
 nhu c=E1=BA=A7u minh h=E1=BB=8Da v=C3=A0 th=E1=BB=B1c h=C3=A0nh l=E1=BA=AD=
p tr=C3=ACnh m=E1=BA=A1ng.</p>
<p local-id=3D"7f66f55e8945"><strong>UDM_08_Chat_TCP_Client_Server</strong>=
 t=E1=BA=ADp trung v=C3=A0o c=C3=A1c ch=E1=BB=A9c n=C4=83ng c=E1=BB=91t l=
=C3=B5i c=E1=BB=A7a m=E1=BB=99t =E1=BB=A9ng d=E1=BB=A5ng chat: thi=E1=BA=BF=
t l=E1=BA=ADp k=E1=BA=BFt n=E1=BB=91i, qu=E1=BA=A3n l=C3=BD phi=C3=AAn Clie=
nt, hi=E1=BB=83n th=E1=BB=8B danh s=C3=A1ch li=C3=AAn h=E1=BB=87, g=E1=BB=
=ADi/nh=E1=BA=ADn tin nh=E1=BA=AFn v=C3=A0 l=C6=B0u l=E1=BB=8Bch s=E1=BB=AD=
 c=E1=BB=A5c b=E1=BB=99. V=C3=AC v=E1=BA=ADy, =E1=BB=A9ng d=E1=BB=A5ng ph=
=C3=B9 h=E1=BB=A3p cho m=E1=BB=A5c ti=C3=AAu h=E1=BB=8Dc t=E1=BA=ADp, th=E1=
=BB=AD nghi=E1=BB=87m giao ti=E1=BA=BFp m=E1=BA=A1ng v=C3=A0 minh h=E1=BB=
=8Da c=C3=A1ch ph=E1=BB=91i h=E1=BB=A3p gi=E1=BB=AFa giao di=E1=BB=87n Qt v=
=E1=BB=9Bi x=E1=BB=AD l=C3=BD socket.</p>
<p local-id=3D"7da900b5ea01">4.M=E1=BB=A5c =C4=91=C3=ADch v=C3=A0 t=E1=BA=
=A7m nh=C3=ACn</p>
<p local-id=3D"470e96ca3d06">Nh=C3=B3m mu=E1=BB=91n x=C3=A2y d=E1=BB=B1ng m=
=E1=BB=99t d=E1=BB=A5ng tr=C3=AAn m=C3=A1y t=C3=ADnh s=E1=BB=AD d=E1=BB=A5n=
g C++ v=C3=A0 b=E1=BB=99 c=C3=B4ng c=E1=BB=A5 m=E1=BA=A1nh m=E1=BA=BD c=E1=
