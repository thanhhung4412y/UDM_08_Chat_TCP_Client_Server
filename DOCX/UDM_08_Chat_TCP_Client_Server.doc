=A5ng, bao g=E1=BB=93m khu v=E1=BB=B1c tr=C3=B2 chuy=E1=BB=87n, danh s=C3=
=A1ch ng=C6=B0=E1=BB=9Di d=C3=B9ng, n=C3=BAt ch=E1=BB=A9c n=C4=83ng v=C3=A0=
 c=C3=A1c th=C3=A0nh ph=E1=BA=A7n t=C6=B0=C6=A1ng t=C3=A1c.</p>
