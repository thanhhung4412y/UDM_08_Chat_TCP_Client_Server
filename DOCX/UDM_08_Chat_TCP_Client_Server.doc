<p local-id=3D"5b1de9488185"><strong>4.4. Quy tr=C3=ACnh x=E1=BB=AD l=C3=BD=
 =C4=91=E1=BA=A7u-cu=E1=BB=91i (end-to-end workflow)</strong></p>
<ol start=3D"1" local-id=3D"8da3c88ecabc">
<li local-id=3D"a16aec7708ab">
<p local-id=3D"e45873b454a3">Giai =C4=91o=E1=BA=A1n 1 - Ki=E1=BB=83m so=C3=
=A1t ph=C3=ADa Client:</p>
</li>
</ol>
<p local-id=3D"17dd4e9e3441">o&nbsp;&nbsp; =C4=90=E1=BA=A3m b=E1=BA=A3o tr=
=E1=BA=A1ng th=C3=A1i k=E1=BA=BFt n=E1=BB=91i Socket TCP/TLS ho=E1=BA=A1t =
=C4=91=E1=BB=99ng =E1=BB=95n =C4=91=E1=BB=8Bnh.</p>
<p local-id=3D"cacda458c449">o&nbsp;&nbsp; Th=E1=BB=B1c hi=E1=BB=87n c=E1=
=BA=AFt t=E1=BB=89a kho=E1=BA=A3ng tr=E1=BA=AFng d=C6=B0 th=E1=BB=ABa b=E1=
=BA=B1ng trimmed() v=C3=A0 ki=E1=BB=83m tra t=C3=ADnh r=E1=BB=97ng c=E1=BB=
=A7a th=C3=B4ng =C4=91i=E1=BB=87p.</p>
<ol start=3D"2" local-id=3D"4704c99d0b60">
<li local-id=3D"3ca493e2e8b3">
<p local-id=3D"3eddcccff6cf">Giai =C4=91o=E1=BA=A1n 2 - X=E1=BB=AD l=C3=BD =
trung t=C3=A2m t=E1=BA=A1i server:</p>
</li>
</ol>
<p local-id=3D"19d2c2f7872c">o&nbsp;&nbsp; X=C3=A1c th=E1=BB=B1c phi=C3=AAn=
 (Authentication): Ki=E1=BB=83m tra ng=C6=B0=E1=BB=9Di g=E1=BB=ADi (sender)=
 =C4=91=C3=A3 ho=C3=A0n t=E1=BA=A5t th=E1=BB=A7 t=E1=BB=A5c =C4=91=C4=83ng =
nh=E1=BA=ADp h=E1=BB=87 th=E1=BB=91ng.</p>
<p local-id=3D"42d66a8db0cd">o&nbsp;&nbsp; Th=E1=BA=A9m =C4=91=E1=BB=8Bnh d=
=E1=BB=AF li=E1=BB=87u (Validation): Ki=E1=BB=83m tra gi=E1=BB=9Bi h=E1=BA=
=A1n k=C3=ADch th=C6=B0=E1=BB=9Bc v=C4=83n b=E1=BA=A3n g=E1=BB=ADi l=C3=AAn=
 (=3D&lt;4000 byte UTF-8).</p>
<p local-id=3D"d6d82460eaf9">o&nbsp;&nbsp; =C4=90=C3=B3ng d=E1=BA=A5u th=C3=
=B4ng =C4=91i=E1=BB=87p (Stamping): B=E1=BB=95 sung m=E1=BB=91c th=E1=BB=9D=
i gian chu=E1=BA=A9n UTC (ISO 8601) v=C3=A0 sinh m=C3=A3 =C4=91=E1=BB=8Bnh =
danh duy nh=E1=BA=A5t _event_id (UUIDv4).</p>
<p local-id=3D"aba6bab95836">o&nbsp;&nbsp; Ph=C3=A2n ph=E1=BB=91i g=C3=B3i =
tin (Routing): Broadcast g=C3=B3i tin =C4=91=E1=BA=BFn to=C3=A0n b=E1=BB=99=
 ph=C3=B2ng chat ho=E1=BA=B7c =C4=91=E1=BB=8Bnh tuy=E1=BA=BFn ch=C3=ADnh x=
=C3=A1c =C4=91=E1=BA=BFn socket c=E1=BB=A7a ng=C6=B0=E1=BB=9Di nh=E1=BA=ADn=
 t=C6=B0=C6=A1ng =E1=BB=A9ng.</p>
<ol start=3D"3" local-id=3D"6a55204f5e28">
<li local-id=3D"3821fadf0d46">
<p local-id=3D"3662b8b3c93b">Giai =C4=91o=E1=BA=A1n 3 - Hi=E1=BB=83n th=E1=
=BB=8B v=C3=A0 l=C6=B0u tr=E1=BB=AF c=E1=BB=A5c b=E1=BB=99 t=E1=BA=A1i Clie=
nt:</p>
</li>
</ol>
<p local-id=3D"f3d4af1dc62d">o&nbsp;&nbsp; An to=C3=A0n giao di=E1=BB=87n: =
Component Historyview l=C3=A0m s=E1=BA=A1ch m=C3=A3 HTML v=C3=A0 render n=
=E1=BB=99i dung hi=E1=BB=83n th=E1=BB=8B l=C3=AAn khung chat QTextBrowser.<=
/p>
<p local-id=3D"7aabd611e318">o&nbsp;&nbsp; L=C6=B0u tr=E1=BB=AF l=E1=BB=8Bc=
h s=E1=BB=AD: Component Historystore th=E1=BB=B1c hi=E1=BB=87n ghi b=E1=BA=
=A3n ghi tin nh=E1=BA=AFn v=C3=A0o c=C6=A1 s=E1=BB=9F d=E1=BB=AF li=E1=BB=
=87u SQLite c=E1=BB=A5c b=E1=BB=99 tr=C3=AAn thi=E1=BA=BFt b=E1=BB=8B.</p>
<p local-id=3D"3ee4a0344626"><strong>4.5. C=C3=A1c c=C6=A1 ch=E1=BA=BF b=E1=
=BA=A3o m=E1=BA=ADt v=C3=A0 t=E1=BB=91i =C6=B0u h=C3=B3a k=E1=BB=B9 thu=E1=
=BA=ADt</strong></p>
<p local-id=3D"d46749a453d8"><strong>4.5.1. B=E1=BA=A3o m=E1=BA=ADt k=C3=AA=
nh truy=E1=BB=81n (transport layer security)</strong></p>
<ul local-id=3D"89b16833bcca">
<li local-id=3D"d2d0ee478ee9">
<p local-id=3D"118ce9d99ee7">M=C3=A3 h=C3=B3a =C4=91=C6=B0=E1=BB=9Dng truy=
=E1=BB=81n: B=E1=BA=AFt bu=E1=BB=99c to=C3=A0n b=E1=BB=99 c=C3=A1c phi=C3=
=AAn truy=E1=BB=81n nh=E1=BA=ADn d=E1=BB=AF li=E1=BB=87u ph=E1=BA=A3i thi=
=E1=BA=BFt l=E1=BA=ADp m=C3=A3 h=C3=B3a TLS 1.2+ th=C3=A0nh c=C3=B4ng.</p>
</li>
<li local-id=3D"00bb7c4259a9">
<p local-id=3D"cf498be7a61f">Ch=C3=ADnh s=C3=A1ch t=E1=BB=AB ch=E1=BB=91i P=
laintext: Tuy=E1=BB=87t =C4=91=E1=BB=91i kh=C3=B4ng cho ph=C3=A9p g=E1=BB=
=ADi/nh=E1=BA=ADn g=C3=B3i tin tr=C3=B2 chuy=E1=BB=87n khi socket =E1=BB=9F=
 tr=E1=BA=A1ng th=C3=A1i Plaintext TCP.</p>
</li>
</ul>
<p local-id=3D"d38663af2ec8"><strong>4.5.2. Ki=E1=BB=83m so=C3=A1t d=E1=BB=
=AF li=E1=BB=87u =C4=91=E1=BA=A7u v=C3=A0o</strong></p>
<ul local-id=3D"879d42264499">
<li local-id=3D"489113b6df86">
<p local-id=3D"6ea12d6b42d7">Ki=E1=BB=83m tra t=C3=ADnh r=E1=BB=97ng: Lo=E1=
=BA=A1i b=E1=BB=8F c=C3=A1c tin nh=E1=BA=AFn ch=E1=BB=89 ch=E1=BB=A9a kho=
=E1=BA=A3ng tr=E1=BA=AFng.</p>
</li>
<li local-id=3D"a2700cc71a59">
<p local-id=3D"1945076cd8ef">Gi=E1=BB=9Bi h=E1=BA=A1n dung l=C6=B0=E1=BB=A3=
ng g=C3=B3i tin:</p>
</li>
</ul>
<p local-id=3D"e1ea0b2549e8">o&nbsp;&nbsp; N=E1=BB=99i dung tin nh=E1=BA=AF=
n ch=C3=ADnh : Gi=E1=BB=9Bi h=E1=BA=A1n t=E1=BB=91i =C4=91a 4.000 byte (UTF=
-8).</p>
<p local-id=3D"7a4408204c85">o&nbsp;&nbsp; N=E1=BB=99i dung tin nh=E1=BA=AF=
n tr=C3=ADch d=E1=BA=ABn : Gi=E1=BB=9Bi h=E1=BA=A1n t=E1=BB=91i =C4=91a 1.0=
00 byte (UTF-8).</p>
<p local-id=3D"1e64010e3f23">o&nbsp;&nbsp; C=C6=A1 ch=E1=BA=BF gi=C3=BAp ng=
=C4=83n ch=E1=BA=B7n t=E1=BA=A5n c=C3=B4ng tr=C3=A0n b=E1=BB=99 nh=E1=BB=9B=
 =C4=91=E1=BB=87m v=C3=A0 hi=E1=BB=87n t=C6=B0=E1=BB=A3ng spam l=C3=A0m suy=
 gi=E1=BA=A3m hi=E1=BB=87u n=C4=83ng h=E1=BB=87 th=E1=BB=91ng.</p>
<p local-id=3D"17cd043c79c9"><strong>4.5.3. Ch=E1=BB=91ng t=E1=BA=A5n c=C3=
=B4ng XSS v=C3=A0 ti=C3=AAm m=C3=A3 =C4=91=E1=BB=99c giao di=E1=BB=87n</str=
ong></p>
<ul local-id=3D"cccbd84d40b4">
<li local-id=3D"69c11d4e64b8">
<p local-id=3D"46f599421afc">M=E1=BB=8Di chu=E1=BB=97i v=C4=83n b=E1=BA=A3n=
 tr=C6=B0=E1=BB=9Bc khi =C4=91=C6=B0a v=C3=A0o document HTML c=E1=BB=A7a QT=
extBrowser =C4=91=E1=BB=81u b=E1=BA=AFt bu=E1=BB=99c ch=E1=BA=A1y qua h=C3=
=A0m toHtmlEscaped() c=E1=BB=A7a Qt.</p>
</li>
<li local-id=3D"d9782af0ef38">
<p local-id=3D"cddfd552b1f9">C=C3=A1c th=E1=BA=BB HTML nguy h=E1=BA=A1i (nh=
=C6=B0 &lt;script&gt;, &lt;style&gt;, &lt;iframe&gt;) s=E1=BA=BD t=E1=BB=B1=
 =C4=91=E1=BB=99ng chuy=E1=BB=83n =C4=91=E1=BB=95i th=C3=A0nh d=E1=BA=A1ng =
th=E1=BB=B1c th=E1=BB=83 HTML (HTML entities) =C4=91=E1=BB=83 hi=E1=BB=83n =
th=E1=BB=8B thu=E1=BA=A7n t=C3=BAy d=C6=B0=E1=BB=9Bi d=E1=BA=A1ng v=C4=83n =
b=E1=BA=A3n, tri=E1=BB=87t ti=C3=AAu ho=C3=A0n to=C3=A0n nguy c=C6=A1 th=E1=
=BB=B1c thi m=C3=A3 =C4=91=E1=BB=99c client-side.</p>
</li>
</ul>
